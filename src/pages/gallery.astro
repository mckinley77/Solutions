---
import BaseLayout from '../layouts/BaseLayout.astro';

const photos: { src: string; caption: string; description?: string }[] = [
	{ src: '/images/gallery/rainfall-trends.jpg', caption: 'Rainfall Trends', description: 'This shows the trend of winter rainfall in recent years. Some up some down but the trend is clear.' },
	{ src: '/images/gallery/17th-fairway-survey.jpg', caption: '17th Fairway Survey', description: 'Here’s an early survey, done with a simple level and hand drawn.' },
	{ src: '/images/gallery/8th-fairway-survey.png', caption: '8th Fairway Survey', description: 'On flat fairways, a level survey allows contours to be produced and low areas defined that would not be obvious to the naked eye. CAD drawings make this so much easier.' },
	{ src: '/images/gallery/8th-future-drainage.png', caption: '8th Future Drainage', description: 'The survey allows future drainage to be planned and optimised to ensure drains have adequate gradient and depth' },
	{ src: '/images/gallery/8th-survey2.png', caption: '8th Survey 2', description: 'Contours show the areas likely to pond in heavy rainfall.' },
	{ src: '/images/gallery/example-contours.jpg', caption: 'Example Contours', description: 'This contour plan from an aerial survey made the drainage design much easier.' },
	{ src: '/images/gallery/between-17th-and-18th.jpg', caption: 'Flooding over a drain!', description: 'Drains can only function if the water can get into them and this shows ponding directly over a sealed drain.' },
	{ src: '/images/gallery/drain-design-example.jpg', caption: 'Drain Design Example', description: 'Once surveys and investigations are completed, a drainage design can be produced showing what can be retained and improved and what new drainage is required.' },
	{ src: '/images/gallery/example-b.jpg', caption: 'Design Example', description: 'Good clear notes drawings and notes will make any project easier to understand and control.' },
	{ src: '/images/gallery/eighth-cs.jpg', caption: '8th Cross-Section', description: 'Simple sketches like this can ensure that everyone knows what is to be constructed and how it will look.' },
	{ src: '/images/gallery/drains-by-excavator.png', caption: 'Drains by Excavator', description: 'A low pressure tracked excavator is often the best way to lay deep or large drains or where ground conditions are unsuitable for trenchers.' },
	{ src: '/images/gallery/trencher.jpg', caption: 'Trencher', description: 'A narrow bucket trencher can install drains very quickly and neatly, if the soil is not too stony.' },
	{ src: '/images/gallery/refreshed-drain.jpg', caption: 'Refreshed Drain', description: 'An old drain refreshed and rejuvenated by skimming off the top turf and replacing with gravel. Simple, quick, low cost.' },
	{ src: '/images/gallery/sand-washout.jpg', caption: 'Sand Washout', description: 'Sand topping drains can lead to embarrassment if heavy rain follows. Coarse gravel is more stable and freer draining. Ideally 6mm on fairways and 20mm in the rough.' },
	{ src: '/images/gallery/gravel-drains.jpg', caption: 'Gravel Drains', description: 'Old gravel drains that have been refreshed cleanly and easily by removing and replacing the surface gravel.' },
	{ src: '/images/gallery/best-of-both-worlds-3.png', caption: 'Best of Both Worlds', description: 'Robotic mowers and traditional reel mowers can work together to improve fairway condition.' },
	{ src: '/images/gallery/bank-stabilisation.jpg', caption: 'Bank Stabilisation', description: 'Plans for the works prepared from the survey drawing.' },
	{ src: '/images/gallery/banks-stabilised.jpg', caption: 'Banks Stabilised', description: 'Proposals to make a steep river bank stable and easier to maintain.' },
	{ src: '/images/gallery/gabion-solution.jpg', caption: 'Gabion Solution', description: 'Gabions stone filled mesh baskets and are another option for stabilising river banks or other slopes, which may be inaccessible to heavy machinery. They can be filled by hand in position.' },
	{ src: '/images/gallery/causeway-6.jpg', caption: 'Causeway Over River', description: 'Often a stone filled causeway over a pipe will be much less expensive than a bridge.' },
	{ src: '/images/gallery/course-plan.jpg', caption: 'Course Plan', description: 'It’s good to have an agreed course plan for staff to set out when the cutting season commences.' },
	{ src: '/images/gallery/leaves-in-rough.jpg', caption: 'Leaves in Rough', description: 'Cutting rough short in winter can help avoid build-up of leaves that are easily blown away on shorter grass.' },
	{ src: '/images/gallery/temp-green-much-too-small.jpg', caption: 'Temp Green - Much too Small', description: 'Temporary greens can be very useful and essential on some courses but make them a decent size so the flag can be moved.' },
	{ src: '/images/gallery/golpa.jpg', caption: 'Golpa', description: 'Plastic “egg box” units can help stabilise gravel paths on slopes or grassed over to give occasional vehicular access routes.' },
	{ src: '/images/gallery/gravel-drain.jpg', caption: 'Gravel Drain', description: 'Typical gravel drain construction with minimum pipe cover of 450mm to prevent damage by spiking or Vertidrain.' },
	{ src: '/images/gallery/range-bays.png', caption: 'Range Bays', description: 'Design of a couple of range bays with a wider coaching bay.' },
	{ src: '/images/gallery/practice-area.png', caption: 'Practice Area', description: 'Design for new tees and targets on a practice area.' },
	{ src: '/images/gallery/sleeper-wall.png', caption: 'Sleeper Wall', description: 'An attractive sleeper wall around a tee where space was too tight to allow a sloped bank.' },
	{ src: '/images/gallery/crib-wall.jpg', caption: 'Crib Wall', description: 'A crib wall made with interlocking sections of concrete, wood or recycled plastic can be an easy way to stabilise a bank and blend the structure into the environment.' },
	{ src: '/images/gallery/spring-again.jpg', caption: 'Spring Again', description: 'Cherry trees in full bloom in Spring at Shandon Park framing the fairway.' },
	{ src: '/images/gallery/3rd-river-narrowed.png', caption: 'Algae in stream', description: 'Unsightly algae can take over a slow flowing stream in summer, requiring a lot of maintenance. Simply narrowing the stream will speed up flow and control the problem. Think “Rae’s Creek” with a few boulders and gravel beds to liven up the flow.' },
	{ src: '/images/gallery/moneyreagh-diversion.jpg', caption: 'Moneyreagh Diversion', description: 'This was a simple way to allow low flow through the existing pond but divert high flows downstream, to prevent the pond from overflowing in storms.' },
];
---

<BaseLayout
	title="Gallery"
	description="Photos of drainage, survey, and sustainability projects on golf courses."
>
	<section class="section section--tight hero">
		<div class="container">
			<span class="eyebrow">Gallery</span>
			<h1>Project photos</h1>
			<p class="lede">Photos from drainage, survey, and structural projects on golf courses.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="gallery-masonry">
				{photos.map(({ src, caption, description }, index) => (
					<div class="gallery-masonry__item">
						<button
							type="button"
							class="gallery-masonry__trigger"
							data-src={src}
							data-caption={caption}
							data-description={description ?? ''}
							data-index={index}
							aria-label={`View larger image: ${caption}`}
						>
							<img src={src} alt={caption} loading="lazy" />
						</button>
						<p>{caption}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<div class="lightbox" id="lightbox" aria-hidden="true">
		<button type="button" class="lightbox__close" id="lightbox-close" aria-label="Close">
			&times;
		</button>
		<button type="button" class="lightbox__nav lightbox__nav--prev" id="lightbox-prev" aria-label="Previous image">
			&#8249;
		</button>
		<button type="button" class="lightbox__nav lightbox__nav--next" id="lightbox-next" aria-label="Next image">
			&#8250;
		</button>
		<figure class="lightbox__figure">
			<img class="lightbox__image" id="lightbox-image" src="" alt="" />
			<figcaption class="lightbox__caption" id="lightbox-caption"></figcaption>
			<p class="lightbox__description" id="lightbox-description" hidden></p>
		</figure>
	</div>
</BaseLayout>

<style>
	.gallery-masonry {
		columns: 3;
		column-gap: 1.75rem;
	}

	.gallery-masonry__item {
		break-inside: avoid;
		margin-bottom: 1.75rem;
	}

	.gallery-masonry img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
	}

	.gallery-masonry p {
		margin: 0.5rem 0 0;
		font-size: 1.05rem;
	}

	@media (max-width: 900px) {
		.gallery-masonry {
			columns: 2;
		}
	}

	@media (max-width: 560px) {
		.gallery-masonry {
			columns: 1;
		}
	}

	.gallery-masonry__trigger {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: zoom-in;
	}

	.gallery-masonry__trigger img {
		transition: opacity 0.15s ease;
	}

	.gallery-masonry__trigger:hover img,
	.gallery-masonry__trigger:focus-visible img {
		opacity: 0.85;
	}

	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 100;
		background: rgba(16, 38, 28, 0.92);
		align-items: center;
		justify-content: center;
		padding: 3rem 1rem;
	}

	.lightbox.is-open {
		display: flex;
	}

	.lightbox__figure {
		margin: 0;
		max-width: 90vw;
		max-height: 85vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.lightbox__image {
		display: block;
		max-width: 90vw;
		max-height: 76vh;
		width: auto;
		height: auto;
		border-radius: 8px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
	}

	.lightbox__caption {
		color: #f4f7f5;
		font-size: 1.25rem;
		font-weight: 600;
		text-align: center;
	}

	.lightbox__description {
		margin: 0;
		max-width: 40rem;
		color: #d4dfd9;
		font-size: 1.05rem;
		line-height: 1.5;
		text-align: center;
	}

	.lightbox__close,
	.lightbox__nav {
		position: fixed;
		background: rgba(255, 255, 255, 0.1);
		color: #ffffff;
		border: none;
		border-radius: 999px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		transition: background 0.15s ease;
	}

	.lightbox__close:hover,
	.lightbox__nav:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	.lightbox__close {
		top: 1.25rem;
		right: 1.25rem;
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.75rem;
	}

	.lightbox__nav {
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		font-size: 2rem;
	}

	.lightbox__nav--prev {
		left: 1rem;
	}

	.lightbox__nav--next {
		right: 1rem;
	}

	@media (max-width: 640px) {
		.lightbox__nav {
			width: 2.5rem;
			height: 2.5rem;
			font-size: 1.5rem;
		}

		.lightbox__close {
			top: 0.75rem;
			right: 0.75rem;
			width: 2.5rem;
			height: 2.5rem;
		}
	}
</style>

<script>
	const triggers = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.gallery-masonry__trigger')
	);
	const lightbox = document.getElementById('lightbox');
	const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
	const lightboxCaption = document.getElementById('lightbox-caption');
	const lightboxDescription = document.getElementById('lightbox-description');
	const closeBtn = document.getElementById('lightbox-close');
	const prevBtn = document.getElementById('lightbox-prev');
	const nextBtn = document.getElementById('lightbox-next');

	let currentIndex = 0;

	function show(index: number) {
		if (!lightbox || !lightboxImage || !lightboxCaption || !lightboxDescription) return;
		const total = triggers.length;
		currentIndex = (index + total) % total;
		const trigger = triggers[currentIndex];
		lightboxImage.src = trigger.dataset.src ?? '';
		lightboxImage.alt = trigger.dataset.caption ?? '';
		lightboxCaption.textContent = trigger.dataset.caption ?? '';
		const description = trigger.dataset.description ?? '';
		lightboxDescription.textContent = description;
		lightboxDescription.hidden = description === '';
	}

	function open(index: number) {
		if (!lightbox) return;
		show(index);
		lightbox.classList.add('is-open');
		lightbox.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	}

	function close() {
		if (!lightbox) return;
		lightbox.classList.remove('is-open');
		lightbox.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	triggers.forEach((trigger, index) => {
		trigger.addEventListener('click', () => open(index));
	});

	closeBtn?.addEventListener('click', close);
	prevBtn?.addEventListener('click', () => show(currentIndex - 1));
	nextBtn?.addEventListener('click', () => show(currentIndex + 1));

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) close();
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox?.classList.contains('is-open')) return;
		if (event.key === 'Escape') close();
		if (event.key === 'ArrowLeft') show(currentIndex - 1);
		if (event.key === 'ArrowRight') show(currentIndex + 1);
	});
</script>
