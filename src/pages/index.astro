---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('technical-notes'))
	.filter((note) => !note.data.draft)
	.sort((a, b) => b.data.number - a.data.number);

const latestNote = (await getCollection('technical-notes')).sort(
	(a, b) => b.data.number - a.data.number
)[0];
---

<BaseLayout
	title="Golf that Doesn't Cost the Earth"
	description="Simple Solutions for Sustainable Golf - practical drainage and sustainability guidance for golf courses managing wet winters and short playing seasons, led by Maurice McKinley BSc CEng MICE."
>
	<section class="hero">
		<div class="hero__banner">
			<img
				class="hero__banner-image"
				src="/images/hero.jpg"
				alt="A golf green beside a pond, with a wooden bridge, reeds, and mature trees under a clear evening sky"
			/>
		</div>
		<div class="container hero__content">
			<h1 class="hero__tagline">Drier courses, longer playing seasons, lower costs.</h1>
			<div class="hero__panel">
				<p class="lede">
					<strong>A well-run golf course will cost less, not more!</strong>
				</p>
				<p class="lede">
					Everything on this site is aimed at providing practical, low-cost solutions for
					drainage, machinery, and everyday course management, helping golf courses stay
					drier, remain open for longer, spend less, avoid paying twice to fix the same
					problem, and protect water, trees, and habitats.
				</p>
				<p class="lede">
					Ireland's wetter winters have made all of this harder, with shorter playing seasons
					and rising costs, which is exactly why the approach matters now.
				</p>
				<p class="lede">
					<em><strong>The objective:</strong> a course members are proud of... without costing the
					earth.</em>
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow">The aim of this project</span>
			<p class="lede">
				This project shares practical experience and low-cost solutions to the problems golf
				clubs face in the current climate: drainage failures, winter damage, water shortages in
				summer, tree management, and how new technology can genuinely help.
			</p>
			<p class="lede">
				It also aims to help clubs develop longer-term plans and cost-effective practices
				rather than struggling with the same issues year after year on tight budgets, and to
				spark conversation, interest, and observations from others in the golf world that can
				be shared for everyone's benefit.
			</p>
			<div class="grid grid--3" style="margin-top:2.5rem;">
				<div class="card">
					<h3>Drainage</h3>
					<p>
						Low-cost, drainage improvements to get greens, tees, and fairways playable earlier
						in spring and later into the autumn, engineered and planned, not guesswork.
					</p>
					<a href="/drainage/">Read more →</a>
				</div>
				<div class="card">
					<h3>Sustainability</h3>
					<p>
						The sustainability objectives here are practical: reducing fuel use and emissions,
						protecting trees and habitats, and making better use of resources, and embracing
						technology like robotic mowing to work smarter and reduce our environmental
						footprint.
					</p>
					<a href="/sustainability/">Read more →</a>
				</div>
				<div class="card">
					<h3>Technical Notes</h3>
					<p>
						Practical notes on drainage, machinery, and the problems clubs deal with, drawn from
						extensive contract and drainage design experience and years as a committee member
						and convenor.
					</p>
					<a href="/technical-notes/">Browse notes →</a>
				</div>
			</div>
		</div>
	</section>

	{latestNote && (
		<section class="section section--alt">
			<div class="container">
				<div class="grid grid--2">
					<div class="card note-card">
						<span class="eyebrow">Latest Technical Note</span>
						{latestNote.data.draft && <span class="badge-draft">Draft - coming soon</span>}
						<p class="note-card__meta">Technical Note {latestNote.data.number}</p>
						<h3><a href={`/technical-notes/${latestNote.id}/`}>{latestNote.data.title}</a></h3>
						<p>{latestNote.data.summary}</p>
						<a href={`/technical-notes/${latestNote.id}/`}>Read the note →</a>
					</div>
					<div class="card">
						<span class="eyebrow">Free Tool</span>
						<img
							src="/images/robot-mower-calculator.png"
							alt="Robotic Mowing Business Case Generator, comparing conventional mowing with a hybrid robotic strategy"
							style="width:100%; height:auto; border-radius:8px; margin-bottom:1rem; border:1px solid var(--color-border);"
						/>
						<h3>Robotic Mowing Business Case Calculator</h3>
						<p>
							Compare conventional mowing with a hybrid robotic strategy using your own figures,
							see installed cost, annual savings, and greenkeeper capacity released.
						</p>
						<a
							href="https://mckinley77.github.io/robot-mower-business-case/"
							target="_blank"
							rel="noopener"
						>
							Try the calculator →
						</a>
					</div>
				</div>
			</div>
		</section>
	)}

	<section class="section">
		<div class="container">
			<div class="card" style="display:flex; flex-wrap:wrap; gap:1.5rem; align-items:center; justify-content:space-between;">
				<div>
					<h2 style="margin-top:0;">Free introductory consultation</h2>
					<p style="margin-bottom:0; max-width:34rem;">
						A half-day, no-obligation consultation to look at your drainage and sustainability
						priorities and where the quickest wins are.
					</p>
				</div>
				<a class="btn btn--primary" href="/contact/">Get in touch</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.section {
		padding: 2.25rem 0;
	}

	.hero + .section {
		padding-top: 1rem;
	}

	.section--alt {
		padding-top: 1rem;
	}
</style>
