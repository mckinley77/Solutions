---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Services"
	description="From survey to site supervision - surveys and mapping, structural engineering advice, and full project delivery for golf course drainage and sustainability work."
>
	<section class="section section--tight hero">
		<div class="container">
			<span class="eyebrow">Services</span>
			<h1>From Survey to Site Supervision</h1>
			<p class="lede">
				Most of my work follows the same path: understand what's there, work out what's needed,
				then see it through. Here's how I can help at each stage.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="grid grid--3">
				<div class="card">
					<button
						type="button"
						class="gallery-masonry__trigger"
						data-src="/images/survey-with-contours.jpg"
						data-caption="Aerial survey with contour lines"
						data-index="0"
						aria-label="View larger image: Aerial survey with contour lines"
					>
						<img
							src="/images/survey-with-contours.jpg"
							alt="Aerial survey of a golf course with contour lines overlaid"
							style="width:100%; height:auto; border-radius:8px; margin-bottom:1rem;"
						/>
					</button>
					<h3>Surveys &amp; Mapping</h3>
					<p>
						Every project starts with knowing what you're actually working with. This may involve
						course and contour surveys, drone surveys, and production of a drainage map, often the
						first accurate record a club has ever had of its own system. It's usually very
						inexpensive to produce, and it's the foundation everything else is built on.
					</p>
					<a href="/services/surveys-maps/">Read more about drainage and course mapping →</a>
				</div>
				<div class="card">
					<button
						type="button"
						class="gallery-masonry__trigger"
						data-src="/images/range-bays-cropped.png"
						data-caption="Range bays structure design"
						data-index="1"
						aria-label="View larger image: Range bays structure design"
					>
						<img
							src="/images/range-bays-cropped.png"
							alt="CAD design of a range bay structure with dimensions"
							style="width:100%; height:auto; border-radius:8px; margin-bottom:1rem;"
						/>
					</button>
					<h3>Structures</h3>
					<p>
						Golf courses often involve more built infrastructure than people realise: bridges,
						culverts, retaining walls, slopes that need stabilising. I provide general engineering
						advice on all of these, identifying what's sound, what needs attention, and what the
						options are for fixing it, in the simplest and least expensive way.
					</p>
					<a href="/services/structures/">Talk through a structure on your course →</a>
				</div>
				<div class="card">
					<button
						type="button"
						class="gallery-masonry__trigger"
						data-src="/images/programme.png"
						data-caption="Example works programme"
						data-index="2"
						aria-label="View larger image: Example works programme"
					>
						<img
							src="/images/programme.png"
							alt="Example works programme showing scheduled drainage tasks, timing, and costs"
							style="width:100%; height:auto; border-radius:8px; margin-bottom:1rem;"
						/>
					</button>
					<h3>Project Delivery</h3>
					<p>
						Once the problem is understood, someone has to see the work through. I help clubs put
						together development and course improvement plans, prepare tender documents, and can
						assist with procuring contractors and consultants where needed. For larger projects, I
						can also provide site supervision, so the work that gets done matches what was agreed.
					</p>
					<a href="/contact/">Talk through your project →</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<div class="lightbox" id="lightbox" aria-hidden="true">
	<button type="button" class="lightbox__close" id="lightbox-close" aria-label="Close">
		&times;
	</button>
	<button type="button" class="lightbox__nav lightbox__nav--prev" id="lightbox-prev" aria-label="Previous image">
		&#8249;
	</button>
	<button type="button" class="lightbox__nav lightbox__nav--next" id="lightbox-next" aria-label="Next image">
		&#8250;
	</button>
	<figure class="lightbox__figure">
		<img class="lightbox__image" id="lightbox-image" src="" alt="" />
		<figcaption class="lightbox__caption" id="lightbox-caption"></figcaption>
		<p class="lightbox__description" id="lightbox-description" hidden></p>
	</figure>
</div>

<style>
	.gallery-masonry__trigger {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: zoom-in;
	}

	.gallery-masonry__trigger img {
		transition: opacity 0.15s ease;
	}

	.gallery-masonry__trigger:hover img,
	.gallery-masonry__trigger:focus-visible img {
		opacity: 0.85;
	}

	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 100;
		background: rgba(16, 38, 28, 0.92);
		align-items: center;
		justify-content: center;
		padding: 3rem 1rem;
	}

	.lightbox.is-open {
		display: flex;
	}

	.lightbox__figure {
		margin: 0;
		max-width: 90vw;
		max-height: 85vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.lightbox__image {
		display: block;
		max-width: 90vw;
		max-height: 76vh;
		width: auto;
		height: auto;
		border-radius: 8px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
	}

	.lightbox__caption {
		color: #f4f7f5;
		font-size: 1.25rem;
		font-weight: 600;
		text-align: center;
	}

	.lightbox__description {
		margin: 0;
		max-width: 40rem;
		color: #d4dfd9;
		font-size: 1.05rem;
		line-height: 1.5;
		text-align: center;
	}

	.lightbox__close,
	.lightbox__nav {
		position: fixed;
		background: rgba(255, 255, 255, 0.1);
		color: #ffffff;
		border: none;
		border-radius: 999px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		transition: background 0.15s ease;
	}

	.lightbox__close:hover,
	.lightbox__nav:hover {
		background: rgba(255, 255, 255, 0.22);
	}

	.lightbox__close {
		top: 1.25rem;
		right: 1.25rem;
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.75rem;
	}

	.lightbox__nav {
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		font-size: 2rem;
	}

	.lightbox__nav--prev {
		left: 1rem;
	}

	.lightbox__nav--next {
		right: 1rem;
	}

	@media (max-width: 640px) {
		.lightbox__nav {
			width: 2.5rem;
			height: 2.5rem;
			font-size: 1.5rem;
		}

		.lightbox__close {
			top: 0.75rem;
			right: 0.75rem;
			width: 2.5rem;
			height: 2.5rem;
		}
	}
</style>

<script>
	const triggers = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.gallery-masonry__trigger')
	);
	const lightbox = document.getElementById('lightbox');
	const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
	const lightboxCaption = document.getElementById('lightbox-caption');
	const lightboxDescription = document.getElementById('lightbox-description');
	const closeBtn = document.getElementById('lightbox-close');
	const prevBtn = document.getElementById('lightbox-prev');
	const nextBtn = document.getElementById('lightbox-next');

	let currentIndex = 0;

	function show(index: number) {
		if (!lightbox || !lightboxImage || !lightboxCaption || !lightboxDescription) return;
		const total = triggers.length;
		currentIndex = (index + total) % total;
		const trigger = triggers[currentIndex];
		lightboxImage.src = trigger.dataset.src ?? '';
		lightboxImage.alt = trigger.dataset.caption ?? '';
		lightboxCaption.textContent = trigger.dataset.caption ?? '';
		const description = trigger.dataset.description ?? '';
		lightboxDescription.textContent = description;
		lightboxDescription.hidden = description === '';
	}

	function open(index: number) {
		if (!lightbox) return;
		show(index);
		lightbox.classList.add('is-open');
		lightbox.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	}

	function close() {
		if (!lightbox) return;
		lightbox.classList.remove('is-open');
		lightbox.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	triggers.forEach((trigger, index) => {
		trigger.addEventListener('click', () => open(index));
	});

	closeBtn?.addEventListener('click', close);
	prevBtn?.addEventListener('click', () => show(currentIndex - 1));
	nextBtn?.addEventListener('click', () => show(currentIndex + 1));

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) close();
	});

	document.addEventListener('keydown', (event) => {
		if (!lightbox?.classList.contains('is-open')) return;
		if (event.key === 'Escape') close();
		if (event.key === 'ArrowLeft') show(currentIndex - 1);
		if (event.key === 'ArrowRight') show(currentIndex + 1);
	});
</script>
